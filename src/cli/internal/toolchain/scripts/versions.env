# Pinned versions of the cluster tools installed into ~/.freelunch/bin.
#
# Single source of truth: both installers and pin-tools.sh read this file, so a
# version bump happens in exactly one place. After changing a version here, run
#
#     pixi run task pin:tools
#
# to regenerate checksums.txt, and commit both files together. An unregenerated
# checksums.txt fails the install loudly rather than silently accepting a
# different binary.
#
# kubectl tracks the k3s server that k3d ships (k3s v1.35.x at k3d v5.9.0).
# kubectl supports one minor version of skew either way; keep these in step.
K3D_VERSION=v5.9.0
KUBECTL_VERSION=v1.35.7

# The k3s server k3d boots, and the airgap image bundle that matches it.
#
# This is the upstream *release tag*, which contains a '+'. Docker tags cannot
# contain '+', so the same version appears in k3d-cluster.yaml as
# `rancher/k3s:v1.35.5-k3s1` with a '-'. A Go test asserts the two agree, since
# a silent mismatch would seed the airgap cache with images the cluster never
# asks for — which looks exactly like a working airgap until the network is off.
K3S_VERSION=v1.35.5+k3s1
